{
  "name": "vlogger-server",
  "version": "1.0.0",
  "description": "Streaming vlogging platform",
  "main": "index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "server": "nodemon src/index.ts",
    "db:create": "ts-node ./node_modules/typeorm/cli.js migration:create -n vlog",
    "db:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate -n vlog",
    "db:migrate": "ts-node ./node_modules/typeorm/cli.js migration:run"
  },
  "keywords": [
    "Streaming",
    "vlog",
    "vlogging",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/argon2": "^0.15.0",
    "@types/connect-pg-simple": "^4.2.2",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/redis": "^2.8.32",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "apollo-server-express": "^3.13.0",
    "argon2": "^0.40.1",
    "connect-pg-simple": "^9.0.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "graphql": "^15.8.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^1.1.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  }
}
